<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:t="sap.ui.table">
    <!--   Se enlazan todos los textos al bundle i18n (titulo,
         mensaje de instrucciones, cabeceras de columna y botones) para
         soportar EN/FR; las claves ya existen en i18n.properties.   -->
    <Dialog
        title="{i18n>catalogoOperacionesTitulo}"
        contentWidth="700px"
        contentHeight="500px"
        resizable="true"
        draggable="true">
        <content>
            <VBox class="sapUiSmallMargin">
                <Text text="{i18n>selectOperationsMessage}" class="sapUiSmallMarginBottom" />
                <t:Table
                    id="catalogTable"
                    rows="{catalogModel>/operations}"
                    selectionMode="MultiToggle"
                    visibleRowCount="10"
                    class="sapUiSizeCompact"
                    width="100%">
                    <t:columns>
                        <t:Column width="200px">
                            <Label text="{i18n>codigoOperacion}" />
                            <t:template>
                                <Text text="{catalogModel>Code}" wrapping="false" />
                            </t:template>
                        </t:Column>
                        <t:Column width="400px">
                            <Label text="{i18n>DESCRIPCION}" />
                            <t:template>
                                <Text text="{catalogModel>Description}" wrapping="false" />
                            </t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </VBox>
        </content>
        <beginButton>
            <Button
                text="{i18n>addSelected}"
                type="Emphasized"
                press="onAddSelectedOperations" />
        </beginButton>
        <endButton>
            <Button
                text="{i18n>btnCancelar}"
                press="onCloseCatalogDialog" />
        </endButton>
    </Dialog>
    <!--   -->
</core:FragmentDefinition>