<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:t="sap.ui.table">
    <Dialog
        title="Catálogo de Operaciones"
        contentWidth="700px"
        contentHeight="500px"
        resizable="true"
        draggable="true">
        <content>
            <VBox class="sapUiSmallMargin">
                <Text text="Seleccione una o más operaciones para añadir al capítulo:" class="sapUiSmallMarginBottom" />
                <t:Table
                    id="catalogTable"
                    rows="{catalogModel>/operations}"
                    selectionMode="MultiToggle"
                    visibleRowCount="10"
                    class="sapUiSizeCompact"
                    width="100%">
                    <t:columns>
                        <t:Column width="200px">
                            <Label text="Código de Operación" />
                            <t:template>
                                <Text text="{catalogModel>Code}" wrapping="false" />
                            </t:template>
                        </t:Column>
                        <t:Column width="400px">
                            <Label text="Descripción" />
                            <t:template>
                                <Text text="{catalogModel>Description}" wrapping="false" />
                            </t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </VBox>
        </content>
        <beginButton>
            <Button
                text="Añadir Seleccionados"
                type="Emphasized"
                press="onAddSelectedOperations" />
        </beginButton>
        <endButton>
            <Button
                text="Cancelar"
                press="onCloseCatalogDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>